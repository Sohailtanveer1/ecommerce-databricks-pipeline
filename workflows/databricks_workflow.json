{
  "name": "ecommerce_lakehouse_pipeline",
  "tasks": [
    {
      "task_key": "ingest_orders_batch",
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/ingestion/batch_extract_orders" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "ingest_clickstream_autoloader",
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/ingestion/autoloader_clickstream" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "load_bronze",
      "depends_on": [
        { "task_key": "ingest_orders_batch" },
        { "task_key": "ingest_clickstream_autoloader" }
      ],
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/bronze/bronze_loader" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "transform_silver",
      "depends_on": [{ "task_key": "load_bronze" }],
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/silver/silver_transform_orders" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "merge_gold_dim_product",
      "depends_on": [{ "task_key": "transform_silver" }],
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/gold/gold_dim_product_scd2" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "merge_gold_fact_orders",
      "depends_on": [{ "task_key": "merge_gold_dim_product" }],
      "notebook_task": { "notebook_path": "/Repos/ecommerce-databricks-pipeline/src/gold/gold_fact_orders" },
      "job_cluster_key": "small_job_cluster"
    },
    {
      "task_key": "refresh_materialized_views",
      "depends_on": [{ "task_key": "merge_gold_fact_orders" }],
      "sql_task": {
        "warehouse_id": "<sql-warehouse-id>",
        "file": { "path": "/Repos/ecommerce-databricks-pipeline/sql/materialized_views.sql" }
      }
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "small_job_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "autoscale": { "min_workers": 1, "max_workers": 4 }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 3 * * ?",
    "timezone_id": "UTC"
  },
  "email_notifications": {
    "on_failure": ["data-team@company.com"]
  }
}
