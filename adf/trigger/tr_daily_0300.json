{
  "name": "tr_daily_0300",
  "properties": {
    "description": "Daily tumbling window; passes window bounds to the pipeline for incremental JDBC copy.",
    "type": "TumblingWindowTrigger",
    "typeProperties": {
      "frequency": "Hour",
      "interval": 24,
      "startTime": "2026-08-27T03:00:00Z",
      "delay": "00:05:00",
      "maxConcurrency": 1,
      "retryPolicy": { "count": 2, "intervalInSeconds": 300 }
    },
    "pipeline": {
      "pipelineReference": { "referenceName": "pl_ecommerce_batch", "type": "PipelineReference" },
      "parameters": {
        "windowStart": "@trigger().outputs.windowStartTime",
        "windowEnd": "@trigger().outputs.windowEndTime",
        "run_date": "@formatDateTime(trigger().outputs.windowStartTime, 'yyyy-MM-dd')"
      }
    }
  }
}
