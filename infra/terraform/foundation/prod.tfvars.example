# PROD environment. Copy to prod.tfvars (gitignored) and fill in.
# Applied by CI only on a vX.Y.Z tag with manual approval (azure-prod environment).
# Prod ideally lives in its own subscription with private networking.
project     = "ecomlake"
environment = "prod"
location    = "eastus"

# Prod deploy service principal / platform-admin object id.
my_object_id = "00000000-0000-0000-0000-000000000000"

# Production source systems.
postgres_jdbc_url = "jdbc:postgresql://prod-erp-db:5432/ecommerce"
postgres_username = "ecom_reader"
postgres_password = "set-in-ci-from-key-vault"

fx_api_key = ""

log_retention_days = 90
extra_containers   = []
